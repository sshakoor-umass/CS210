{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Make submission zip",
      "detail": "Gather your submission files into submission.zip for Gradescope.",
      "type": "shell",
      "command": "./gradlew",
      "args": ["makeSubmissionZipfile"],
      "windows": { "command": ".\\gradlew.bat" },
      "options": { "cwd": "${workspaceFolder}" },
      "group": "build",
      "problemMatcher": [],
      "presentation": { "reveal": "always", "clear": true, "panel": "shared" }
    }
  ]
}
